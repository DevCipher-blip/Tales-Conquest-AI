# Read by `docker compose` from the repository root. Copy to .env to change
# anything; with no .env the stack runs the offline provider.

# local (default): deterministic, offline, no key required
# venice:          hosted models via the Venice AI API (needs VENICE_API_KEY)
DOORMAN_PROVIDER=local
VENICE_API_KEY=

# Text-to-speech for Marcus. Only used by the venice provider.
DOORMAN_TTS_ENABLED=false
